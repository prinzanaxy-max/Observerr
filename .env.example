# Copy to .env for local runs (never commit .env).
# Production: set the same keys in Railway → Variables.

# Web Push VAPID — generate with: npx web-push generate-vapid-keys
# Public key must match Observer-UI VITE_VAPID_PUBLIC_KEY / .env.production
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@observerr.app

# Used in push notification deep links
APP_FRONTEND_BASE_URL=https://observerr-ui.pages.dev
