            "url": "{{baseUrl}}/api/lecturer/proctoring/exams/{{examId}}/media-token",
            "description": "Subscribe-only LiveKit token for exam owner."
          }
        }
      ]
    },
    {
      "name": "Lecturer — Analytics",
      "item": [
        {
          "name": "Overview (7D)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/lecturer/analytics/overview?period=7D",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lecturer", "analytics", "overview"],
              "query": [{ "key": "period", "value": "7D", "description": "7D | 30D | 3M" }]
            }
          }
        },
        {
          "name": "Overview (30D)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/lecturer/analytics/overview?period=30D"
          }
        },
        {
          "name": "Overview (3M)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/lecturer/analytics/overview?period=3M"
          }
        },
        {
          "name": "Integrity Events Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/lecturer/analytics/integrity-events?period=7D&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lecturer", "analytics", "integrity-events"],
              "query": [
                { "key": "period", "value": "7D", "description": "7D | 30D | 3M" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "eventType", "value": "", "disabled": true },
                { "key": "severity", "value": "", "disabled": true }
              ]
            }
          }
        }
