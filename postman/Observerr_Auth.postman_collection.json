    {
      "name": "Devices",
      "item": [
        {
          "name": "Register Web Push Subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/example\",\n  \"keys\": {\n    \"p256dh\": \"p256dh-public-key\",\n    \"auth\": \"auth-secret\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/devices/token",
            "description": "200 `{ success, message }`. Re-registering the same endpoint transfers ownership to the current user."
          }
        },
        {
          "name": "Unregister Web Push Subscription",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/example\",\n  \"keys\": {\n    \"p256dh\": \"p256dh-public-key\",\n    \"auth\": \"auth-secret\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/devices/token",
            "description": "204 No Content when the subscription belongs to the caller."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/notifications?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "category", "value": "EXAM", "disabled": true, "description": "EXAM | INTEGRITY | RESULT | SYSTEM" },
                { "key": "unreadOnly", "value": "false", "disabled": true }
              ]
            },
            "description": "200 page `{ content[], page, size, totalElements, totalPages, unreadCount }`."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const c = pm.response.json().content;",
                "  if (c && c.length) {",
                "    pm.collectionVariables.set('notificationId', String(c[0].id));",
                "    pm.environment.set('notificationId', String(c[0].id));",
                "  }",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Mark Notification Read",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }
        },
        {
          "name": "Mark All Read",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" }
        },
        {
          "name": "Delete Notification",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/notifications/{{notificationId}}" }
        },
        {
          "name": "Get Notification Preferences",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications/preferences" }
        },
        {
          "name": "Update Notification Preferences",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examEvents\": true,\n  \"integrityAlerts\": true,\n  \"resultUpdates\": true,\n  \"systemUpdates\": true\n}"
            },
            "url": "{{baseUrl}}/api/notifications/preferences"
          }
        }
      ]
    },
