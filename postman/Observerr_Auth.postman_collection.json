{
  "info": {
    "name": "Observerr API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Complete Observerr backend API (~40 requests) — auth, account, student results/stats/exams, integrity ingest, lecturer exams, dashboard, students, proctoring, analytics, devices.\n\n**Setup:** Import `Observerr.postman_environment.json`, select the Observerr environment, then run **Login (Demo Lecturer)** or **Login (Demo Student)**.\n\n**Student exams:** `GET /api/student/exams` returns all **published** exams. **Start Session** requires a published exam (`404` otherwise).\n\n**Create exam:** `POST /api/lecturer/exams` with `\"publish\": true` enrolls all student users.\n\nProduction: `https://observerr-production.up.railway.app`\nFrontend: `https://observerr-ui.pages.dev`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://observerr-production.up.railway.app" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "examId", "value": "1" },
    { "key": "sessionId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Demo Student)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institutionalId\": \"STU-12345\",\n  \"password\": \"YOUR_PASSWORD\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', j.accessToken);",
                "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                "  pm.environment.set('accessToken', j.accessToken);",
                "  pm.environment.set('refreshToken', j.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Login (Demo Lecturer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institutionalId\": \"STU-67890\",\n  \"password\": \"YOUR_PASSWORD\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', j.accessToken);",
                "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                "  pm.environment.set('accessToken', j.accessToken);",
                "  pm.environment.set('refreshToken', j.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Register (Student)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institutionalId\": \"STU-001\",\n  \"email\": \"student@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const j = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', j.accessToken);",
                "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Register (Lecturer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institutionalId\": \"LEC-001\",\n  \"email\": \"lecturer@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"LECTURER\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const j = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', j.accessToken);",
                "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{refreshToken}}" }],
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  pm.collectionVariables.set('accessToken', j.accessToken);",
                "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"allDevices\": false }" },
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Me (Auth)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/account/me" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"User\"\n}"
            },
            "url": "{{baseUrl}}/api/account/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"oldPass1\",\n  \"newPassword\": \"newPass2\",\n  \"confirmPassword\": \"newPass2\"\n}"
            },
            "url": "{{baseUrl}}/api/account/me/password"
          }
        },
        {
          "name": "Upload Profile Picture",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": "{{baseUrl}}/api/account/me/profile-picture"
          }
        },
        {
          "name": "Delete Profile Picture",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/account/me/profile-picture" }
        }
      ]
    },
    {
      "name": "Student",
      "item": [
        {
          "name": "List Results",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/student/results?page=0&size=10&sort=MOST_RECENT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "results"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "MOST_RECENT", "description": "MOST_RECENT | OLDEST | HIGHEST_INTEGRITY | LOWEST_INTEGRITY" }
              ]
            }
          }
        },
        {
          "name": "Results Summary",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/student/results/summary" }
        },
        {
          "name": "Dashboard Stats",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/student/stats" }
        },
        {
          "name": "List Exams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/student/exams",
            "description": "All published exams for any student (not enrollment-only). Response: `{ exams[], totalElements }`."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const j = pm.response.json();",
                "  if (j.exams && j.exams.length) {",
                "    const pick = j.exams.find(e => e.status === 'LIVE') || j.exams[0];",
                "    pm.collectionVariables.set('examId', String(pick.id));",
                "    pm.environment.set('examId', String(pick.id));",
                "  }",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Get Exam Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/student/exams/{{examId}}" }
        }
      ]
    },
    {
      "name": "Integrity (Student)",
      "item": [
        {
          "name": "Start Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"startingScore\": 100\n}" },
            "url": "{{baseUrl}}/api/student/exams/{{examId}}/sessions",
            "description": "Exam must be **published**. Returns 201 with UUID sessionId; 404 if exam missing/unpublished; 409 if session already IN_PROGRESS."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('sessionId', pm.response.json().sessionId);",
                "  pm.environment.set('sessionId', pm.response.json().sessionId);",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Batch Integrity Events",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"clientEventId\": \"11111111-1111-1111-1111-111111111111\",\n      \"eventCode\": \"TAB_BLUR\",\n      \"title\": \"Tab switched away\",\n      \"description\": \"Student left exam tab\",\n      \"severity\": \"MEDIUM\",\n      \"pointsDeducted\": 5,\n      \"scoreAfter\": 95,\n      \"requiresReview\": false,\n      \"timestamp\": \"2026-07-28T14:05:30Z\",\n      \"durationMs\": 3000,\n      \"metadata\": { \"tabTitle\": \"Google\" }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/student/exam-sessions/{{sessionId}}/integrity-events"
          }
        },
        {
          "name": "Complete Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": {\n    \"sessionId\": \"{{sessionId}}\",\n    \"examId\": {{examId}},\n    \"startedAt\": \"2026-07-28T14:00:00Z\",\n    \"endedAt\": \"2026-07-28T16:00:00Z\",\n    \"startingScore\": 100,\n    \"finalScore\": 87,\n    \"totalEvents\": 1,\n    \"totalDeductions\": 13,\n    \"requiresReview\": false,\n    \"proctoringAvailable\": true\n  },\n  \"events\": []\n}"
            },
            "url": "{{baseUrl}}/api/student/exam-sessions/{{sessionId}}/complete"
          }
        }
      ]
    },
    {
      "name": "Lecturer — Exams",
      "item": [
        {
          "name": "List Exams",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/lecturer/exams?status=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lecturer", "exams"],
              "query": [
                { "key": "status", "value": "ALL", "description": "ALL | LIVE | UPCOMING | COMPLETED" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Exam Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/exams/{{examId}}" }
        },
        {
          "name": "Create Exam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Midterm Exam\",\n  \"course\": \"CS201: Data Structures\",\n  \"startAt\": \"2026-08-01T14:00:00\",\n  \"durationMinutes\": 120,\n  \"security\": {\n    \"webcamMonitoring\": true,\n    \"tabSwitchTracking\": true,\n    \"blockCopyPaste\": false\n  },\n  \"publish\": true\n}"
            },
            "url": "{{baseUrl}}/api/lecturer/exams",
            "description": "When `publish` is true, all STUDENT users are enrolled automatically."
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const id = pm.response.json().id;",
                "  pm.collectionVariables.set('examId', String(id));",
                "  pm.environment.set('examId', String(id));",
                "}"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Start Exam (Go Live)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/lecturer/exams/{{examId}}/start" }
        }
      ]
    },
    {
      "name": "Lecturer — Students",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/lecturer/students?page=0&size=10&course=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lecturer", "students"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "course", "value": "ALL" }
              ]
            }
          }
        },
        {
          "name": "Session Detail (UUID or legacy ID)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/students/sessions/{{sessionId}}" }
        }
      ]
    },
    {
      "name": "Lecturer — Dashboard",
      "item": [
        {
          "name": "Dashboard Home",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/dashboard" }
        },
        {
          "name": "Needs Review",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/students/needs-review?limit=10" }
        },
        {
          "name": "Live Sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/exams/{{examId}}/live-sessions" }
        }
      ]
    },
    {
      "name": "Lecturer — Proctoring",
      "item": [
        {
          "name": "List Live Exams",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/proctoring/exams" }
        },
        {
          "name": "Exam Feeds",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/lecturer/proctoring/exams/{{examId}}/feeds" }
        }
      ]
    },
    {
      "name": "Lecturer — Analytics",
      "item": [
        {
          "name": "Overview (7D)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/lecturer/analytics/overview?period=7D",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lecturer", "analytics", "overview"],
              "query": [{ "key": "period", "value": "7D", "description": "7D | 30D | 3M" }]
            }
          }
        },
        {
          "name": "Overview (30D)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/lecturer/analytics/overview?period=30D"
          }
        },
        {
          "name": "Overview (3M)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/lecturer/analytics/overview?period=3M"
          }
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Register FCM Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-device-token-from-firebase\"\n}"
            },
            "url": "{{baseUrl}}/api/devices/token"
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Protected Route Without Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Login Wrong Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institutionalId\": \"STU-12345\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Analytics Unsupported Period",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/lecturer/analytics/overview?period=Custom"
          }
        },
        {
          "name": "Student Route as Lecturer (403)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/student/exams" }
        }
      ]
    }
  ]
}
